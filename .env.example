# Copy to .env and fill in locally. Never commit real credentials.
# Copy the connection string from Supabase Dashboard > Connect.
# For this persistent Node API, use Direct if the host supports IPv6,
# otherwise use Supavisor Session mode. Do not use Transaction mode here.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# TLS is on and certificate verification is on by default. Set PGSSL=require
# only if your provider requires encrypted connections without certificate verification.
# For local PostgreSQL without TLS only: PGSSL=disable
PG_POOL_SIZE=5
NODE_ENV=development
PORT=3000
ORGANISATION_NAME=Green Harvest Uganda Ltd
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-at-least-12-characters

# Private AWS S3 bucket for project and farm pictures; keep bucket private.
AWS_REGION=af-south-1
AWS_BUCKET=green-harvest-private-media
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
